{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "omnicasa-app values",
  "description": "additionalProperties is false at the top level on purpose: a typo like `replicasCount` would otherwise be accepted silently and the app would deploy with the default. helm lint catches it here instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "config", "service", "ingress"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "strategy": { "type": "object" },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string", "minLength": 1 }
      }
    },

    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variables": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "secrets": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
          }
        }
      }
    },

    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },

    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },

    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": ["integer", "null"], "minimum": 0 },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containerPort", "port"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "extraPorts": { "type": "array", "items": { "type": "object" } },
        "extraServicePorts": { "type": "array", "items": { "type": "object" } }
      }
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array", "items": { "type": "object" } },
        "extraRules": { "type": "array", "items": { "type": "object" } }
      }
    },

    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "lifecycle": { "type": "object" },
    "resources": { "type": "object" },

    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "triggers": { "type": "array", "items": { "type": "object" } },
        "advanced": { "type": "object" }
      }
    },

    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },

    "initContainers": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },

    "hostAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ip", "hostnames"],
        "properties": {
          "ip": { "type": "string" },
          "hostnames": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },

    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "restartPolicy": { "enum": ["Never", "OnFailure"] },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 },
        "hookWeight": { "type": "integer" },
        "resources": { "type": "object" }
      }
    },

    "cronJobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "schedule"],
        "properties": {
          "name": { "type": "string" },
          "schedule": { "type": "string" },
          "image": { "type": "string" },
          "command": { "type": "array", "items": { "type": "string" } },
          "args": { "type": "array", "items": { "type": "string" } },
          "concurrencyPolicy": { "enum": ["Allow", "Forbid", "Replace"] },
          "suspend": { "type": "boolean" },
          "restartPolicy": { "enum": ["Never", "OnFailure"] },
          "backoffLimit": { "type": "integer", "minimum": 0 },
          "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
          "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
          "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
          "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
          "resources": { "type": "object" }
        }
      }
    },

    "extraManifests": { "type": "array", "items": { "type": "object" } },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" }
  }
}
